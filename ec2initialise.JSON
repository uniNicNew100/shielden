{
    "AWSTemplateFormatVersion": "2010-09-09",
    "Description": "CloudFormation template to create an EC2 instance for Shielden suite, managed via SSM, with no inbound traffic allowed and DCV for GUI access.",
    "Resources": {
        "ShieldenVPC": {
            "Type": "AWS::EC2::VPC",
            "Properties": {
                "CidrBlock": "10.0.0.0/16",
                "EnableDnsSupport": true,
                "EnableDnsHostnames": true,
                "Tags": [
                    {
                        "Key": "Name",
                        "Value": "ShieldenVPC"
                    }
                ]
            }
        },
        "ShieldenInternetGateway": {
            "Type": "AWS::EC2::InternetGateway",
            "Properties": {
                "Tags": [
                    {
                        "Key": "Name",
                        "Value": "ShieldenInternetGateway"
                    }
                ]
            }
        },
        "ShieldenGatewayAttachment": {
            "Type": "AWS::EC2::VPCGatewayAttachment",
            "Properties": {
                "VpcId": {
                    "Ref": "ShieldenVPC"
                },
                "InternetGatewayId": {
                    "Ref": "ShieldenInternetGateway"
                }
            }
        },
        "ShieldenPublicSubnet": {
            "Type": "AWS::EC2::Subnet",
            "Properties": {
                "VpcId": {
                    "Ref": "ShieldenVPC"
                },
                "CidrBlock": "10.0.1.0/24",
                "MapPublicIpOnLaunch": true,
                "Tags": [
                    {
                        "Key": "Name",
                        "Value": "ShieldenPublicSubnet"
                    }
                ]
            }
        },
        "ShieldenPublicRouteTable": {
            "Type": "AWS::EC2::RouteTable",
            "Properties": {
                "VpcId": {
                    "Ref": "ShieldenVPC"
                },
                "Tags": [
                    {
                        "Key": "Name",
                        "Value": "ShieldenPublicRouteTable"
                    }
                ]
            }
        },
        "ShieldenDefaultRoute": {
            "Type": "AWS::EC2::Route",
            "DependsOn": "ShieldenGatewayAttachment",
            "Properties": {
                "RouteTableId": {
                    "Ref": "ShieldenPublicRouteTable"
                },
                "DestinationCidrBlock": "0.0.0.0/0",
                "GatewayId": {
                    "Ref": "ShieldenInternetGateway"
                }
            }
        },
        "ShieldenSubnetRouteTableAssociation": {
            "Type": "AWS::EC2::SubnetRouteTableAssociation",
            "Properties": {
                "SubnetId": {
                    "Ref": "ShieldenPublicSubnet"
                },
                "RouteTableId": {
                    "Ref": "ShieldenPublicRouteTable"
                }
            }
        },
        "ShieldenInstanceRole": {
            "Type": "AWS::IAM::Role",
            "Properties": {
                "AssumeRolePolicyDocument": {
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Effect": "Allow",
                            "Principal": {
                                "Service": [
                                    "ec2.amazonaws.com"
                                ]
                            },
                            "Action": [
                                "sts:AssumeRole"
                            ]
                        }
                    ]
                },
                "ManagedPolicyArns": [
                    "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
                ],
                "Policies": [
                    {
                        "PolicyName": "DcvLicence",
                        "PolicyDocument": {
                            "Version": "2012-10-17",
                            "Statement": [
                                {
                                    "Effect": "Allow",
                                    "Action": "s3:GetObject",
                                    "Resource": {
                                        "Fn::Sub": "arn:aws:s3:::dcv-license.${AWS::Region}/*"
                                    }
                                }
                            ]
                        }
                    }
                ]
            }
        },
        "ShieldenInstanceProfile": {
            "Type": "AWS::IAM::InstanceProfile",
            "Properties": {
                "Roles": [
                    {
                        "Ref": "ShieldenInstanceRole"
                    }
                ]
            }
        },
        "ShieldenSecurityGroup": {
            "Type": "AWS::EC2::SecurityGroup",
            "Properties": {
                "GroupDescription": "Shielden suite machine - no inbound traffic, managed via SSM",
                "VpcId": {
                    "Ref": "ShieldenVPC"
                }
            }
        },
        "ShieldenLaunchTemplate": {
            "Type": "AWS::EC2::LaunchTemplate",
            "Properties": {
                "LaunchTemplateName": {
                    "Fn::Sub": "${AWS::StackName}-launch-template"
                },
                "LaunchTemplateData": {
                    "ImageId": "{{resolve:ssm:/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id}}",
                    "InstanceType": "t3.large",
                    "IamInstanceProfile": {
                        "Name": {
                            "Ref": "ShieldenInstanceProfile"
                        }
                    },
                    "SecurityGroupIds": [
                        {
                            "Ref": "ShieldenSecurityGroup"
                        }
                    ],
                    "UserData": {
                        "Fn::Base64": {
                            "Fn::Join": ["\n",[
                            "#!/bin/bash",
                            "export DEBIAN_FRONTEND=noninteractive",
                            "export NEEDRESTART_MODE=a",
                            "apt-get update && apt-get upgrade -y",
                            "#might remove GUI to save resources, but for now we will install it to allow DCV to work",
                            "apt-get install -y curl ubuntu-desktop-minimal gdm3",
                            "systemctl set-default graphical.target",
                            "cd /tmp",
                            "curl -sO https://d1uj6qtbmh3dt5.cloudfront.net/nice-dcv-ubuntu2404-x86_64.tgz",
                            "tar -xzf nice-dcv-ubuntu2404-x86_64.tgz && cd nice-dcv-*-x86_64",
                            "apt-get install -y ./nice-dcv-server_*.deb ./nice-dcv-web-viewer_*.deb ./nice-xdcv_*.deb",
                            "usermod -aG video dcv",
                            "systemctl enable dcvserver",
                            "# This is test password for user, still need to set up script to prompt user to change password on first login",
                            "useradd -m -s /bin/bash shielden && echo 'shielden:ubuntu' | chpasswd",
                            "cd /tmp",
                            "curl -sO https://packages.wazuh.com/4.14/wazuh-install.sh",
                            "bash ./wazuh-install.sh -a",
                            "systemctl stop wazuh-manager",
                            "sed -i '/<vulnerability-detection>/,/<\\/vulnerability-detection>/ s|<enabled>yes</enabled>|<enabled>no</enabled>|' /var/ossec/etc/ossec.conf",
                            "mv /tmp/wazuh-install-files.tar /root/ && chmod 600 /root/wazuh-install-files.tar",
                            "rm -rf /var/ossec/queue/vd /var/ossec/queue/vd_updater /var/ossec/tmp/* /tmp/nice-dcv-* /tmp/wazuh-install.sh",
                            "apt-get clean",
                            "reboot"
                        ]]
                        }
                    },
                    "BlockDeviceMappings": [
                        {
                            "DeviceName": "/dev/sda1",
                            "Ebs": {
                                "VolumeType": "gp3",
                                "VolumeSize": "50"
                            }
                        }
                    ]
                }
            }
        },
        "ShieldenSuiteInstance": {
            "Type": "AWS::EC2::Instance",
            "DependsOn": [
                "ShieldenSubnetRouteTableAssociation",
                "ShieldenDefaultRoute"
            ],
            "Properties": {
                "SubnetId": {
                    "Ref": "ShieldenPublicSubnet"
                },
                "LaunchTemplate": {
                    "LaunchTemplateId": {
                        "Ref": "ShieldenLaunchTemplate"
                    },
                    "Version": {
                        "Fn::GetAtt": [
                            "ShieldenLaunchTemplate",
                            "LatestVersionNumber"
                        ]
                    }
                },
                "Tags": [
                    {
                        "Key": "Name",
                        "Value": "ShieldenSuiteInstance"
                    }
                ]
            }
        }
    },
    "Outputs": {
        "InstanceId": {
            "Description": "ID of the Shielden suite EC2 instance to use on connect script",
            "Value": {
                "Ref": "ShieldenSuiteInstance"
            }
        },
        "VPCId": {
            "Description": "ID of the VPC",
            "Value": {
                "Ref": "ShieldenVPC"
            }
        }
    }
}