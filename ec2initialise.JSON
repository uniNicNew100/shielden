{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Parameters": {
    "VpcId":    { "Type": "AWS::EC2::VPC::Id" },
    "SubnetId": { "Type": "AWS::EC2::Subnet::Id" }
  },
  "Resources": {
    "ShieldenInstanceRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{
            "Effect": "Allow",
            "Principal": { "Service": ["ec2.amazonaws.com"] },
            "Action": ["sts:AssumeRole"]
          }]
        },
        "ManagedPolicyArns": ["arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"]
      }
    },
    "ShieldenInstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": { "Roles": [{ "Ref": "ShieldenInstanceRole" }] }
    },
    "ShieldenSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Shielden suite machine - no inbound, managed via SSM",
        "VpcId": { "Ref": "VpcId" }
      }
    },

    
    "ShieldenLaunchTemplate": {
      "Type": "AWS::EC2::LaunchTemplate",
      "Properties": {
        "LaunchTemplateName": { "Fn::Sub": "${AWS::StackName}-launch-template" },
        "LaunchTemplateData": {
          "ImageId": "{{resolve:ssm:/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id}}",
          "InstanceType": "t3.large",
          "IamInstanceProfile": { "Name": { "Ref": "ShieldenInstanceProfile" } },
          "SecurityGroupIds": [{ "Ref": "ShieldenSecurityGroup" }],
          "UserData": {
            "Fn::Base64": "#!/bin/bash\napt update && apt upgrade -y\napt install curl -y\ncurl -sO https://packages.wazuh.com/4.14/wazuh-install.sh\nbash ./wazuh-install.sh -a"
          },
                "BlockDeviceMappings" : [
        {
            "DeviceName" : "/dev/sda1",
            "Ebs" : { "VolumeSize" : "30" }
        }
        ]
          
        }
      }
    },
    "ShieldenSuiteInstance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "SubnetId": { "Ref": "SubnetId" },
        "LaunchTemplate": {
          "LaunchTemplateId": { "Ref": "ShieldenLaunchTemplate" },
          "Version": { "Fn::GetAtt": ["ShieldenLaunchTemplate", "LatestVersionNumber"] }
        }
      }
    }
  }
}